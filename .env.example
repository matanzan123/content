# Copy to .env.local and fill in. Restart `npm run dev` after any change.

# ---------------------------------------------------------------------------
# Firebase — Google sign-in
# Console > Project settings > Your apps > Web app > SDK setup and configuration
# Then enable Authentication > Sign-in method > Google, and add your domain
# (localhost is allowed by default) under Authentication > Settings >
# Authorized domains.
# These are NEXT_PUBLIC_ on purpose: Firebase web keys are client-side
# identifiers, not secrets. Access is controlled by security rules.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Whop OAuth — creator account linking
# whop.com > Developer > your app > OAuth. The redirect URI below must match
# the one registered there exactly.
# WHOP_CLIENT_SECRET is a real secret — keep it out of NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_REDIRECT_URI=http://localhost:3000/api/whop/callback

# ---------------------------------------------------------------------------
# Firebase Admin — server-side identity verification for /admin
#
# SERVER ONLY. These must never be prefixed NEXT_PUBLIC_: the private key can
# mint credentials for any user in the project. Console > Project settings >
# Service accounts > Generate new private key.
#
# Without all three, admin access is DENIED — there is no development bypass.
# Keep the \n escapes in the private key; paste it as a single line.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Postgres — durable analytics, ledger and audit storage
#
# SERVER ONLY. Never NEXT_PUBLIC_.
#
# Any managed Postgres works. Neon is the recommended host for serverless
# deployments; point this at the POOLED connection string, because each
# serverless instance opens its own connections and a direct endpoint will hit
# the connection limit under traffic.
#
# Without it the site runs normally and analytics is DISABLED — the collector
# stores nothing and the admin dashboard reports "not configured" rather than
# showing zeros that look like real readings.
#
#   npm run db:generate   create a migration from the schema
#   npm run db:migrate    apply migrations
#   npm run db:status     report connection, tables and real row counts
# ---------------------------------------------------------------------------
DATABASE_URL=
