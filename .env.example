# Copy to .env.local and fill in. Restart `npm run dev` after any change.

# ---------------------------------------------------------------------------
# Firebase — Google sign-in
# Console > Project settings > Your apps > Web app > SDK setup and configuration
# Then enable Authentication > Sign-in method > Google, and add your domain
# (localhost is allowed by default) under Authentication > Settings >
# Authorized domains.
# These are NEXT_PUBLIC_ on purpose: Firebase web keys are client-side
# identifiers, not secrets. Access is controlled by security rules.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Whop OAuth — creator ACCOUNT LINKING (not payments)
# whop.com > Developer > your app > OAuth. The redirect URI below must match
# the one registered there exactly.
# WHOP_CLIENT_SECRET is a real secret — keep it out of NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
# The redirect URI must be registered with Whop EXACTLY as written here, and
# must be https in any environment a real browser reaches — the authorization
# code travels back through it.
WHOP_REDIRECT_URI=https://your-domain.example/api/whop/callback

# Encryption key for stored OAuth tokens. SERVER ONLY.
#
# Whop access and refresh tokens are bearer credentials for someone else's
# account, so they are stored AES-256-GCM encrypted rather than in the clear.
# Without this key the Connect Whop flow refuses to start: there is no
# plaintext fallback, because a fallback is the path a leak actually takes.
#
# DEDICATED. Never reuse WHOP_API_KEY or WHOP_WEBHOOK_SECRET here — those
# rotate on their own schedules, and rotating one must not make stored tokens
# unreadable or make a compromised key awkward to retire.
#
# 32 bytes, base64:   openssl rand -base64 32
WHOP_OAUTH_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Whop PAYMENTS — marketplace payments, refunds and creator payouts
#
# A different credential from the OAuth pair above, for a different purpose.
# The OAuth client identifies this app to a creator; the company API key below
# can act AS the ClipRewards company, so treat it like a bank credential.
#
# SERVER ONLY. Never NEXT_PUBLIC_.
#
# WHOP_ENV selects which Whop your money moves in, and there is no default:
#
#   sandbox      https://sandbox-api.whop.com/api/v1   development and testing
#   production   https://api.whop.com/api/v1           real money
#
# It is matched exactly — a missing or misspelled value disables payments
# rather than being guessed at, and can never resolve to production by
# accident. Production requires its OWN key and company id issued by the
# production Whop dashboard; a sandbox key will not work there and must not be
# carried over.
#
# WHOP_COMPANY_ID must begin with "biz_".
#
# Without all three, payments are DISABLED and the app reports that honestly
# rather than pretending a provider is connected.
# ---------------------------------------------------------------------------
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Set to sandbox for development and testing. Empty means payments stay off.
WHOP_ENV=

# Endpoint signing secret for inbound webhooks — a separate credential from
# the API key above. Whop shows it once, prefixed "ws_", when the endpoint is
# created in the dashboard. Paste it verbatim: do not strip the prefix.
#
# Without it /api/webhooks/whop verifies nothing and therefore ACCEPTS
# nothing — every delivery is refused rather than trusted.
WHOP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Public app origin — where a payment provider returns a buyer
#
# SERVER ONLY, and not NEXT_PUBLIC_: every absolute URL built from it is
# assembled on the server, and a browser that wants its own origin already has
# window.location.
#
# Must be an absolute HTTPS origin a provider can actually reach. There is no
# localhost fallback and no invented default: without it, checkout creation is
# refused BEFORE a provider object exists, rather than stranding a buyer at a
# redirect that goes nowhere.
#
#   sandbox      your tunnel origin, e.g. https://<subdomain>.ngrok-free.dev
#   production   the real ClipRewards domain. A tunnel host is rejected here.
#
# Scheme and host only — no path, no trailing slash.
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Sandbox checkout TEST UI — integration infrastructure, not a product feature
#
# SERVER ONLY. Never NEXT_PUBLIC_.
#
# The /checkout/sandbox pages and their API exist only when BOTH:
#
#   WHOP_ENV=sandbox
#   ENABLE_SANDBOX_CHECKOUT_TEST_UI=true
#
# Unset, empty or anything other than the exact string "true" disables them,
# and they answer 404. Two switches rather than one because leaving WHOP_ENV as
# sandbox on a deployed environment is an easy mistake, and it must not be
# enough on its own to publish a page that mounts a payment form.
# ---------------------------------------------------------------------------
ENABLE_SANDBOX_CHECKOUT_TEST_UI=

# ---------------------------------------------------------------------------
# Firebase Admin — server-side identity verification for /admin
#
# SERVER ONLY. These must never be prefixed NEXT_PUBLIC_: the private key can
# mint credentials for any user in the project. Console > Project settings >
# Service accounts > Generate new private key.
#
# Without all three, admin access is DENIED — there is no development bypass.
# Keep the \n escapes in the private key; paste it as a single line.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Postgres — durable analytics, ledger and audit storage
#
# SERVER ONLY. Never NEXT_PUBLIC_.
#
# Any managed Postgres works. Neon is the recommended host for serverless
# deployments; point this at the POOLED connection string, because each
# serverless instance opens its own connections and a direct endpoint will hit
# the connection limit under traffic.
#
# Without it the site runs normally and analytics is DISABLED — the collector
# stores nothing and the admin dashboard reports "not configured" rather than
# showing zeros that look like real readings.
#
#   npm run db:generate   create a migration from the schema
#   npm run db:migrate    apply migrations
#   npm run db:status     report connection, tables and real row counts
# ---------------------------------------------------------------------------
DATABASE_URL=
